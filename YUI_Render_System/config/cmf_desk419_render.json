{
  "description": "Desk419 语义优先渲染映射：不依赖固定结构编号，只根据对象/图层/属性里的材质语义关键词匹配。layers[] 从上到下定优先级（先命中先生效）；支持 match_contains_any / match_prefixes / match_regex / exclude_keywords；未命中由 is_fallback=true 统一兜底。",
  "version": 1,
  "layers": [
    {
      "layer_name": "desk419_accent_orange",
      "material_name": "M_StackStyle_Side_Knob_Industrial_Orange",
      "cmf_note": "撞色件优先（名称出现 Accent/Color/Orange/Knob 等）",
      "match_contains_any": ["Accent", "Color", "Orange", "Knob", "Button"],
      "exclude_keywords": ["Glass", "Lens", "Window", "Screen"],
      "pbr": {
        "base_color": [1.0, 0.35, 0.0, 1.0],
        "roughness": 0.36,
        "metallic": 0.75
      }
    },
    {
      "layer_name": "desk419_screen_glass",
